---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Home page shows a 3-column grid; research page shows a wider 2-column grid. */
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const { title, tag, status, summary } = project.data;
const href = `/research/${project.id}/`;
---

<article class="card card-hover group flex flex-col p-6">
  <p class="kicker">{tag}</p>
  <h3 class:list={['display mt-2 text-xl leading-snug', compact ? 'text-xl' : 'text-2xl']}>
    <a href={href} class="transition-colors group-hover:text-accent">
      {title}
    </a>
  </h3>
  <p class:list={['mt-3 text-sm leading-6 text-ink2', compact && 'line-clamp-3']}>{summary}</p>
  <div class="mt-auto flex items-center justify-between pt-5">
    <span class="font-mono text-[11px] uppercase tracking-wider text-ink2">{status}</span>
    <a
      href={href}
      class="text-sm font-medium text-ink2 transition-colors group-hover:text-accent"
      aria-label={`Read more about ${title}`}
    >
      Details <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

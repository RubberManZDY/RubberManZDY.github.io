---
import type { CollectionEntry } from 'astro:content';

interface Props {
  publication: CollectionEntry<'publications'>;
}

const { publication } = Astro.props;
const { title, authors, venue, venueAbbr, year, status, links } = publication.data;
const primaryLink = links[0]?.url ?? '#';
---

<li class="flex gap-6 py-8 first:pt-0 last:pb-0">
  <!-- Year gutter -->
  <div class="w-16 shrink-0 border-r border-line pr-4 text-right">
    <span class="font-serif text-xl text-ink">{year}</span>
  </div>

  <div class="min-w-0">
    <a href={primaryLink} target="_blank" rel="noopener" class="display block text-xl leading-snug transition-colors hover:text-accent">
      {title}
    </a>

    <p class="mt-2 text-sm text-ink">
      {authors.map((author, i) => (
        <>
          {i === 0 ? <strong class="font-semibold">{author}</strong> : author}
          {i < authors.length - 1 && ', '}
        </>
      ))}
    </p>

    <p class="mt-1.5 text-sm text-ink2">
      {venue}
      {status && <span class="font-mono text-[11px] uppercase tracking-wider text-accent"> · {status}</span>}
    </p>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="rounded-md bg-accent-soft px-2 py-0.5 font-mono text-[11px] font-medium tracking-wider text-accent">
        {venueAbbr}
      </span>
      {
        links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener"
            class="rounded-md border border-line px-2.5 py-0.5 text-xs font-medium text-ink2 transition-colors hover:border-accent hover:text-accent"
          >
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</li>

---
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';

const links = [
  { href: '/', label: 'About' },
  { href: '/research/', label: 'Research' },
  { href: '/publications/', label: 'Publications' },
  { href: '/cv/', label: 'CV' },
];

// Active state: exact match, or prefix match for section pages (/research/...)
const isActive = (href: string) =>
  href === '/'
    ? Astro.url.pathname === '/'
    : Astro.url.pathname.startsWith(href);
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8" aria-label="Main navigation">
    <a href="/" class="font-serif text-lg font-medium tracking-tight text-ink hover:text-accent transition-colors">
      {profile.name}
    </a>

    <div class="hidden items-center gap-7 md:flex">
      <ul class="flex items-center gap-7">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'text-[13px] font-medium tracking-wide transition-colors',
                  isActive(link.href)
                    ? 'text-ink underline decoration-accent decoration-2 underline-offset-8'
                    : 'text-ink2 hover:text-ink',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>

    <div class="flex items-center gap-4 md:hidden">
      <ThemeToggle />
      <button
        id="menu-button"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-md border border-line text-ink"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M2 4.5h12M2 8h12M2 11.5h12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg px-5 py-3 md:hidden">
    <ul class="flex flex-col">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'block rounded-md px-2 py-2.5 text-sm font-medium transition-colors',
                isActive(link.href) ? 'text-accent' : 'text-ink2 hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const button = document.getElementById('menu-button')!;
  const menu = document.getElementById('mobile-menu')!;
  button.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    button.setAttribute('aria-expanded', String(open));
  });
</script>

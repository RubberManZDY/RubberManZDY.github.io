---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, tag, status, start, end, links } = project.data;
const period = start || end ? `${start ?? ''} – ${end ?? ''}` : '';
---

<BaseLayout
  title={title}
  description={`${project.data.summaryLead ? `${project.data.summaryLead} ` : ''}${project.data.summary}`}
>
  <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8 md:py-20">
    <a href="/projects/" class="link-underline text-sm font-medium text-ink2">← All projects</a>

    <header class="mt-8">
      <p class="kicker normal-case">{tag}</p>
      <h1 class="display mt-3 text-4xl leading-tight sm:text-5xl">{title}</h1>
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs uppercase tracking-wider text-ink2">
        <span class="text-accent">{status}</span>
        {period && <span>{period}</span>}
      </div>
      {
        links.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener"
                class="rounded-full border border-line px-4 py-1.5 text-xs font-medium text-ink2 transition-colors hover:border-accent hover:text-accent"
              >
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )
      }
    </header>

    <article class="prose-body mt-10 border-t border-line pt-8">
      <Content />
    </article>
  </div>
</BaseLayout>

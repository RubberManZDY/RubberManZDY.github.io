---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsList from '../components/NewsList.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).filter((p) => p.data.featured);
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <!-- ================= Intro ================= -->
    <section class="grid grid-cols-1 gap-12 py-16 md:grid-cols-[minmax(0,1fr)_300px] md:py-24" aria-labelledby="intro-title">
      <div class="order-last md:order-first">
        <p class="kicker">{profile.eyebrow}</p>
        <h1 id="intro-title" class="display mt-4 text-5xl leading-[1.05] sm:text-6xl">
          {profile.name}
        </h1>
        <p class="mt-4 text-lg text-ink2">{profile.role}</p>

        <p class="mt-6 max-w-xl text-[17px] leading-8 text-ink2">{profile.lead}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/projects/" class="btn-solid">Explore my projects <span aria-hidden="true">→</span></a>
          <a href="/cv/" class="btn-outline">View CV</a>
          <a href={`mailto:${profile.email}`} class="link-underline text-sm font-medium text-ink">
            {profile.email}
          </a>
        </div>
      </div>

      <div class="order-first mx-auto w-64 md:order-last md:mx-0 md:w-full">
        <Portrait />
      </div>
    </section>

    <!-- ================= About ================= -->
    <section class="border-t border-line py-16 md:py-20" aria-labelledby="about-heading">
      <SectionHeading kicker="Background &amp; interests" title="About me" />
      <div class="grid grid-cols-1 gap-12 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
        <div class="space-y-4 text-[15px] leading-7 text-ink2">
          {profile.bio.map((p) => <p>{p}</p>)}
        </div>
        <div>
          <div class="card p-6">
            <h3 class="kicker">Research interests</h3>
            <ul class="mt-4 space-y-3">
              {profile.researchInterests.map((interest) => (
                <li class="flex items-baseline gap-3 text-[15px] text-ink">
                  <span class="h-1 w-1 shrink-0 translate-y-[-2px] rounded-full bg-accent" aria-hidden="true"></span>
                  {interest}
                </li>
              ))}
            </ul>
          </div>
          <p class="mt-4 px-1 text-sm leading-6 text-ink2">
            I am looking for graduate research opportunities in machine learning and wireless communications.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= Education ================= -->
    <section class="border-t border-line py-16 md:py-20" aria-labelledby="education-heading">
      <SectionHeading kicker="Academic background" title="Education" />
      <div class="card p-6 sm:p-8">
        <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-baseline">
          <h3 class="display text-2xl">
            <a href={profile.education.schoolUrl} target="_blank" rel="noopener" class="transition-colors hover:text-accent">
              {profile.education.school}
            </a>
          </h3>
          <span class="shrink-0 font-mono text-xs whitespace-nowrap text-ink2">{profile.education.period}</span>
        </div>
        <p class="mt-1 text-[15px] text-ink2">
          {profile.education.degree}
          {profile.education.note && <span class="block text-sm">{profile.education.note}</span>}
        </p>
        <p class="mt-3 text-sm font-medium text-accent">{profile.education.gpa}</p>
        <div class="mt-5">
          <p class="kicker">Core courses</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {profile.education.courses.map((c) => (
              <li class="rounded-md border border-line px-2.5 py-1 text-xs text-ink2">
                {c.name} <span class="font-mono font-medium text-ink">{c.score}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ================= Selected research ================= -->
    <section class="border-t border-line py-16 md:py-20" aria-labelledby="research-heading">
      <SectionHeading
        kicker="Projects"
        title="Selected projects"
        href="/projects/"
        hrefLabel="All projects"
      />
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} compact />)}
      </div>
    </section>

    <!-- ================= News ================= -->
    <section class="border-t border-line py-16 md:py-20" aria-labelledby="news-heading">
      <SectionHeading kicker="Timeline" title="Recent updates" href="/news/" hrefLabel="All updates" />
      <NewsList items={news} />
    </section>

    <!-- ================= Contact strip ================= -->
    <section class="border-y border-line py-14 md:py-16" aria-labelledby="contact-heading">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
        <div>
          <h2 id="contact-heading" class="display text-3xl">Get in touch</h2>
          <p class="mt-2 text-[15px] text-ink2">I am always happy to discuss research ideas and opportunities.</p>
        </div>
        <a href={`mailto:${profile.email}`} class="btn-solid">
          Email me <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

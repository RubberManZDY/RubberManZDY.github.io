---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profile } from '../data/profile';
import { getCollection, render } from 'astro:content';

const experiences = await getCollection('experience');
const renderedExperiences = await Promise.all(
  experiences.map(async (exp) => ({ exp, body: await render(exp) }))
);
---

<BaseLayout title="CV" description={`Curriculum vitae of ${profile.name}.`}>
  <div class="mx-auto max-w-4xl px-5 py-16 sm:px-8 md:py-20">
    <div class="mb-12 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="kicker mb-2">Curriculum vitae</p>
        <h1 class="display text-4xl">{profile.name}</h1>
        <p class="mt-2 text-[15px] text-ink2">
          {profile.location} · <a href={`mailto:${profile.email}`} class="link-underline">{profile.email}</a>
        </p>
      </div>
      <!-- TODO: drop the resume PDF at public/cv.pdf to activate the download -->
      <a href="/cv.pdf" class="btn-solid" download>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
        </svg>
        Download CV (PDF)
      </a>
    </div>

    <!-- Education -->
    <section class="border-t border-line py-12" aria-labelledby="cv-education">
      <h2 id="cv-education" class="display mb-6 text-2xl">Education</h2>
      <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
        <div>
          <h3 class="text-[15px] font-semibold text-ink">{profile.education.degree}</h3>
          <p class="mt-1 text-sm text-ink2">{profile.education.school}</p>
          <p class="text-sm text-ink2">{profile.education.note}</p>
        </div>
        <span class="font-mono text-xs text-ink2">{profile.education.period}</span>
      </div>
      <p class="mt-3 text-sm font-medium text-accent">{profile.education.gpa}</p>
      <p class="mt-4 text-sm text-ink2">
        <span class="font-medium text-ink">Core courses:</span>{' '}
        {profile.education.courses.map((c) => `${c.name} (${c.score})`).join(' · ')}
      </p>
    </section>

    <!-- Experience -->
    <section class="border-t border-line py-12" aria-labelledby="cv-experience">
      <h2 id="cv-experience" class="display mb-6 text-2xl">Experience</h2>
      {
        renderedExperiences.map(({ exp, body }) => (
          <div class="mb-8 last:mb-0">
            <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
              <h3 class="text-[15px] font-semibold text-ink">{exp.data.role} · {exp.data.org}</h3>
              <span class="font-mono text-xs text-ink2">{exp.data.start} – {exp.data.end}</span>
            </div>
            <div class="prose-body mt-3">
              <body.Content />
            </div>
          </div>
        ))
      }
    </section>

    <!-- Awards -->
    <section class="border-t border-line py-12" aria-labelledby="cv-awards">
      <h2 id="cv-awards" class="display mb-6 text-2xl">Awards</h2>
      <ul class="divide-y divide-line">
        {
          profile.awards.map((award) => (
            <li class="flex flex-col gap-1 py-3.5 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline sm:gap-6">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-ink">{award.title}</p>
                <p class="text-xs text-ink2">{award.issuer}</p>
              </div>
              <span class="font-mono text-xs text-accent">{award.date}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Skills -->
    <section class="border-t border-line py-12" aria-labelledby="cv-skills">
      <h2 id="cv-skills" class="display mb-6 text-2xl">Skills</h2>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {
          profile.skills.map((group) => (
            <div class="card p-5">
              <p class="kicker">{group.group}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <li class="rounded-md bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent-strong">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Honors & other -->
    <section class="border-t border-line py-12" aria-labelledby="cv-honors">
      <h2 id="cv-honors" class="display mb-6 text-2xl">Honors &amp; Activities</h2>
      <ul class="divide-y divide-line">
        {
          profile.honors.map((honor) => (
            <li class="flex flex-col gap-1 py-3.5 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline sm:gap-6">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-ink">{honor.title}</p>
                <p class="text-xs text-ink2">{honor.issuer}</p>
              </div>
              <span class="font-mono text-xs text-accent">{honor.date}</span>
            </li>
          ))
        }
        {
          profile.other.map((entry) => (
            <li class="flex flex-col gap-1 py-3.5 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline sm:gap-6">
              <div class="min-w-0 flex-1">
                <p class="text-sm text-ink">
                  <span class="font-medium">{entry.label}:</span> {entry.value}
                </p>
              </div>
              {entry.date && <span class="font-mono text-xs text-accent">{entry.date}</span>}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
